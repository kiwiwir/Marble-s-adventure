  m_Script: {fileID: 11500000, guid: 4c3123130db224d45a77cee047322601, type: 3}
  m_Name: Cutscene Dialog
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: b90acb33a755d494cafdd1d36518e58b, type: 2}
    text: ...What just happened? Did the train stop?
    expressionName: surprised
  - speaker: {fileID: 11400000, guid: 21e4c61027200ed4cb69b6c975342017, type: 2}
    text: Attention passengers. Due to unforeseen technical issues, this train will
      not continue its journey.
    expressionName: 
  - speaker: {fileID: 11400000, guid: 21e4c61027200ed4cb69b6c975342017, type: 2}
    text: We kindly ask all passengers to disembark at the next stop.
    expressionName: 
  - speaker: {fileID: 11400000, guid: 21e4c61027200ed4cb69b6c975342017, type: 2}
    text: We apologize for the inconvenience, and thank you for your understanding.
    expressionName: 
  - speaker: {fileID: 11400000, guid: b90acb33a755d494cafdd1d36518e58b, type: 2}
    text: Alright... I guess I better get off this train.
    expressionName: 
