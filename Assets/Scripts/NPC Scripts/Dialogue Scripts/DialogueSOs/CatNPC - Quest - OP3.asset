  dialogueID: CatNPC - Quest - OP3
  lines:
  - speaker: {fileID: 11400000, guid: b90acb33a755d494cafdd1d36518e58b, type: 2}
    textENG: "Alright\u2026 I\u2019ll go get it."
    textPL: "No dobrze\u2026 p\xF3jd\u0119 go poszuka\u0107."
    expressionName: default
  - speaker: {fileID: 11400000, guid: a7aa6b929d7ec3a4b872bb20756e679a, type: 2}
    textENG: "Good. Return to me once you have it.\nDon\u2019t get distracted by
      those silly slimes!"
    textPL: "\u015Awietnie. Wr\xF3\u0107 do mnie, kiedy ju\u017C go b\u0119dziesz
      mie\u0107.\r\nI nie daj si\u0119 rozproszy\u0107 tym g\u0142upim potworom!"
    expressionName: charming
