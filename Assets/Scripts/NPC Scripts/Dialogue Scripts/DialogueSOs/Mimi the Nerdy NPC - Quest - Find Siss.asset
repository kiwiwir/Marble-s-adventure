  m_Name: Mimi the Nerdy NPC - Quest - Find Siss
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 1964226d4f853d248af65a60e0a53924, type: 2}
    textENG: 'Ah! A new wanderer! Excellent.

      Before I reveal any critical
      data, you must consult my associates.'
    textPL: "Ah! Nowy w\u0119drowcze! Doskonale.\r\nZanim ujawni\u0119 jakiekolwiek
      istotne informacje, musisz skonsultowa\u0107 si\u0119 z moimi wsp\xF3\u0142pracownikami."
    expressionName: 
  - speaker: {fileID: 11400000, guid: b90acb33a755d494cafdd1d36518e58b, type: 2}
    textENG: "Fine, I\u2019ll go meet them."
    textPL: "Dobrze, p\xF3jd\u0119 ich spotka\u0107."
    expressionName: talking
  - speaker: {fileID: 11400000, guid: 1964226d4f853d248af65a60e0a53924, type: 2}
    textENG: Splendid.
    textPL: Wspaniale.
    expressionName: talking
