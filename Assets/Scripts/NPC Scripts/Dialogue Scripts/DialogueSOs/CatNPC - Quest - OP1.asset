  dialogueID: CatNPC - Quest - OP1
  lines:
  - speaker: {fileID: 11400000, guid: b90acb33a755d494cafdd1d36518e58b, type: 2}
    textENG: What exactly do you want me to get?
    textPL: "Co dok\u0142adnie mam zdoby\u0107?"
    expressionName: surprised
  - speaker: {fileID: 11400000, guid: a7aa6b929d7ec3a4b872bb20756e679a, type: 2}
    textENG: "A small pebble.\nNothing fancy at first glance, but it\u2019s very
      special for me.\r\nYou\u2019ll find it in a chest up north."
    textPL: "Ma\u0142y kamyk.\r\nNa pierwszy rzut oka nic szczeg\xF3lnego, ale dla
      mnie ma ogromn\u0105 warto\u015B\u0107.\r\nZnajdziesz go w skrzyni na p\xF3\u0142nocy."
    expressionName: default
  options:
  - optionTextENG: Alright.
    optionTextPL: "W porz\u0105dku."
    nextDialogue: {fileID: 11400000, guid: e32ef8e5aa4146e4f88dd1ebed234ebb, type: 2}
