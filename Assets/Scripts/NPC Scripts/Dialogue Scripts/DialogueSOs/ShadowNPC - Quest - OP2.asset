  - speaker: {fileID: 11400000, guid: b90acb33a755d494cafdd1d36518e58b, type: 2}
    textENG: "Is this\u2026 dangerous?"
    textPL: "Czy to\u2026 niebezpieczne?"
    expressionName: scared
  - speaker: {fileID: 11400000, guid: bb5a1510bd3107843b8b1bf657c397f9, type: 2}
    textENG: "For me?\r\nNo.\r\nFor others\u2026\r\n\u2026I don't know."
    textPL: "Dla mnie?\r\nNie.\r\nDla innych\u2026\r\n...nie wiem"
    expressionName: default
