MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4c3123130db224d45a77cee047322601, type: 3}
  m_Name: ShadowNPC - Quest - Turn-In
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  dialogueID: ShadowNPC - Quest - Turn-In
  lines:
  - speaker: {fileID: 11400000, guid: b90acb33a755d494cafdd1d36518e58b, type: 2}
    textENG: I got the potion you wanted.
    textPL: "Mam mikstur\u0119, o kt\xF3r\u0105 prosi\u0142e\u015B."
    expressionName: awkward
  - speaker: {fileID: 11400000, guid: bb5a1510bd3107843b8b1bf657c397f9, type: 2}
    textENG: "\u2026You did?\r\nShow me."
    textPL: "\u2026Naprawd\u0119?\r\nPoka\u017C mi."
    expressionName: smiling
  - speaker: {fileID: 11400000, guid: bb5a1510bd3107843b8b1bf657c397f9, type: 2}
    textENG: "Ahh\u2026 yes. That scent. That power. You\u2019ve done well, wanderer."
    textPL: "Ahh\u2026 tak. Ten zapach. Ta moc. Dobrze si\u0119 spisa\u0142e\u015B,
      w\u0119drowcze."
    expressionName: smiling
  - speaker: {fileID: 11400000, guid: b90acb33a755d494cafdd1d36518e58b, type: 2}
    textENG: "So\u2026 what will you do with it?"
    textPL: "Wi\u0119c\u2026 co z tym zrobisz?"
    expressionName: surprised
  - speaker: {fileID: 11400000, guid: bb5a1510bd3107843b8b1bf657c397f9, type: 2}
    textENG: 'Curiosity is a charming flaw.

      But I won''t tell you today.'
    textPL: "Ciekawo\u015B\u0107 to urocza wada.\r\nAle nie powiem ci dzi\u015B."
    expressionName: smiling
  - speaker: {fileID: 11400000, guid: bb5a1510bd3107843b8b1bf657c397f9, type: 2}
    textENG: "Take this reward \u2014 and forget you ever saw me."
    textPL: "We\u017A t\u0119 nagrod\u0119 \u2014 i zapomnij, \u017Ce kiedykolwiek
      mnie widzia\u0142a\u015B."
    expressionName: default
  - speaker: {fileID: 11400000, guid: b90acb33a755d494cafdd1d36518e58b, type: 2}
    textENG: "That\u2019s\u2026 not ominous at all."
    textPL: "To\u2026 wcale nie jest z\u0142owieszcze."
    expressionName: sad
  - speaker: {fileID: 11400000, guid: bb5a1510bd3107843b8b1bf657c397f9, type: 2}
    textENG: "You\u2019ll understand its purpose when you reach the train\u2026"
    textPL: "Zrozumiesz, do czego to s\u0142u\u017Cy, kiedy dotrzesz do poci\u0105gu\u2026"
    expressionName: default
  options: []
  offerQuestOnEnd: {fileID: 0}
  requiredCompletedQuests:
  - {fileID: 11400000, guid: e92a766a61f36ca4cb79bd29c834e690, type: 2}
